{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanban Desktop Preview",
  "version": "0.1.0",
  "identifier": "io.github.tchanryan.kanban.session5",
  "build": { "frontendDist": "../../dist-desktop" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "main",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../spikes/desktop-storage/icons/icon.ico"]
  }
}
